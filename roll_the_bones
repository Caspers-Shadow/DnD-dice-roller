const THEME_META = {
  emerald:   { name: 'Emerald Table',    swatch: ['#1B3A2F', '#E8C77A'], torch: 0xffcf99, rim: 0xbcd4ff, particle: { type: 'firefly', count: 16, color: '#E8C77A' } },
  dragon:    { name: 'Dragonfire Hoard', swatch: ['#3B1414', '#FBD98A'], torch: 0xff8a50, rim: 0xff5a3c, particle: { type: 'ember',   count: 18, color: '#FF7A3D' } },
  moon:      { name: 'Ninth Moon',       swatch: ['#16213A', '#E4ECFB'], torch: 0xbcd4ff, rim: 0xe4ecfb, particle: { type: 'star',    count: 24, color: '#E4ECFB' }, fairy: true },
  parchment: { name: 'Sunlit Parchment', swatch: ['#D3A272', '#8C5A1E'], torch: 0xffe0a0, rim: 0xffcf8a, particle: { type: 'mote',    count: 14, color: '#F0C987' } },
  frost:     { name: 'Frostspire',       swatch: ['#A8C8E0', '#5D7E97'], torch: 0xdff0ff, rim: 0xffffff, particle: { type: 'snow',    count: 26, color: '#BFE0FF' }, fairy: true },
};
const THEME_ORDER = ['emerald', 'dragon', 'moon', 'parchment', 'frost'];

function buildAmbience(themeId) {
  const wrap = document.getElementById('ambience');
  wrap.innerHTML = LANDSCAPES[themeId] || '';
  if (reducedMotion) return;

  const meta = THEME_META[themeId];
  const p = meta.particle;
  for (let i = 0; i < p.count; i++) {
    const el = document.createElement('div');
    el.className = 'particle p-' + p.type;
    el.style.setProperty('--glow', p.color);
    el.style.setProperty('--drift', (Math.random() * 60 - 30) + 'px');
    el.style.left = Math.random() * 100 + 'vw';
    if (p.type === 'star') el.style.top = Math.random() * 55 + 'vh';
    const baseDur = { ember: 5, snow: 10, star: 4, firefly: 13, mote: 15 }[p.type] || 12;
    const dur = baseDur + Math.random() * baseDur * 0.6;
    el.style.animationDuration = dur + 's';
    el.style.animationDelay = (-Math.random() * dur) + 's';
    const size = p.type === 'star' ? 2 + Math.random() * 2 : 3 + Math.random() * 3;
    el.style.width = el.style.height = size + 'px';
    wrap.appendChild(el);
  }

  if (meta.fairy) {
    const count = 2;
    for (let i = 0; i < count; i++) {
      const f = document.createElement('div');
      f.className = 'fairy';
      f.style.setProperty('--glow', p.color === '#BFE0FF' ? '#BFE0FF' : '#E4ECFB');
      const dur = 20 + Math.random() * 6;
      f.style.animationDuration = dur + 's';
      f.style.animationDelay = (-Math.random() * dur) + 's';
      wrap.appendChild(f);
    }
  }
}

function applyTheme(themeId) {
  document.documentElement.setAttribute('data-theme', themeId);
  localStorage.setItem('rtb-theme', themeId);
  const meta = THEME_META[themeId];
  torch.color.setHex(meta.torch);
  rimLight.color.setHex(meta.rim);
  buildAmbience(themeId);
}

const themeSelectEl = document.getElementById('themeSelect');
const savedTheme = localStorage.getItem('rtb-theme');
const initialTheme = THEME_ORDER.includes(savedTheme) ? savedTheme : 'emerald';

THEME_ORDER.forEach(id => {
  const meta = THEME_META[id];
  const btn = document.createElement('button');
  btn.className = 'theme-swatch' + (id === initialTheme ? ' active' : '');
  btn.style.background = `linear-gradient(135deg, ${meta.swatch[0]}, ${meta.swatch[1]})`;
  btn.title = meta.name;
  btn.setAttribute('aria-label', meta.name);
  btn.setAttribute('aria-pressed', id === initialTheme ? 'true' : 'false');
  btn.addEventListener('click', () => {
    applyTheme(id);
    [...themeSelectEl.querySelectorAll('.theme-swatch')].forEach(b => {
      const active = b === btn;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  });
  themeSelectEl.appendChild(btn);
});

applyTheme(initialTheme);
</script>
