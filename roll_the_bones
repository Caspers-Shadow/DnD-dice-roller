<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Roll the Bones — Dice Tray</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
  /* =======================================================================
     THEMES
     Each theme redefines the same set of semantic variables, so every
     other rule in this file (tray, buttons, ledger, dice tabs) automatically
     re-skins itself. Dice gem colors stay fixed on purpose — a real set of
     dice doesn't change color with the room.
     ======================================================================= */
  :root{
    /* Emerald Table — dark, default */
    --bg: #1C1712;
    --bg-glow: #2a1810;
    --felt: #1B3A2F;
    --felt-light: #234A3B;
    --felt-dark: #0D1F19;
    --accent: #C9A356;
    --accent-dark: #8C6B32;
    --accent-bright: #E8C77A;
    --text: #EFE3C8;
    --text-dim: #B8A98A;
    --ink: #1C1712;
    --panel-a: #2a2018;
    --panel-b: #1a140f;
    --crit: #E8B93E;
    --fail: #C0584A;

    --display: 'Cinzel', serif;
    --body: 'Crimson Pro', serif;
    --mono: 'JetBrains Mono', monospace;
  }

  html[data-theme="dragon"]{
    --bg: #170D0B; --bg-glow: #4a1a12;
    --felt: #3B1414; --felt-light: #59211E; --felt-dark: #1C0808;
    --accent: #E8B93E; --accent-dark: #8A5A1E; --accent-bright: #FBD98A;
    --text: #F3DCC0; --text-dim: #C79A78;
    --ink: #170D0B;
    --panel-a: #2e1710; --panel-b: #1c0d08;
  }

  html[data-theme="moon"]{
    --bg: #0E1220; --bg-glow: #2a3a66;
    --felt: #16213A; --felt-light: #22314F; --felt-dark: #0A0F1A;
    --accent: #B9C9EA; --accent-dark: #4B5C7A; --accent-bright: #E4ECFB;
    --text: #E7EDFB; --text-dim: #93A3C4;
    --ink: #0E1220;
    --panel-a: #1a2033; --panel-b: #10141f;
  }

  html[data-theme="parchment"]{
    --bg: #F3E9D2; --bg-glow: #e8caa0;
    --felt: #B98255; --felt-light: #D3A272; --felt-dark: #8C5A34;
    --accent: #C98F3E; --accent-dark: #8C5A1E; --accent-bright: #F0C987;
    --text: #3B2A1A; --text-dim: #7A6142;
    --ink: #241608;
    --panel-a: #EADFC4; --panel-b: #DECBA3;
  }

  html[data-theme="frost"]{
    --bg: #EAF2F8; --bg-glow: #bcdcf0;
    --felt: #7FA8C9; --felt-light: #A8C8E0; --felt-dark: #4E7896;
    --accent: #8FB3D6; --accent-dark: #5D7E97; --accent-bright: #F8FBFF;
    --text: #16232E; --text-dim: #55697A;
    --ink: #0F1820;
    --panel-a: #DCE9F3; --panel-b: #C7DCEB;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    min-height: 100%;
    color: var(--text);
    font-family: var(--body);
  }

  body {
    display: flex;
    justify-content: center;
    padding: 44px 20px 80px;
    background: radial-gradient(ellipse at 50% -10%, var(--bg-glow) 0%, transparent 60%), var(--bg);
    transition: background-color 0.5s ease, color 0.5s ease;
  }

  .stage { width: 100%; max-width: 920px; display: flex; flex-direction: column; align-items: center; }

  header { text-align: center; margin-bottom: 18px; }

  .eyebrow {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.32em;
    text-transform: uppercase; color: var(--accent); margin: 0 0 10px;
    transition: color 0.5s ease;
  }

  h1 {
    font-family: var(--display); font-weight: 700; font-size: clamp(34px, 6vw, 56px);
    letter-spacing: 0.04em; margin: 0; color: var(--text);
    transition: color 0.5s ease;
  }
  h1 span { color: var(--accent-bright); transition: color 0.5s ease; }

  /* ---- theme swatches ---- */
  .theme-select {
    display: flex; gap: 10px; align-items: center; justify-content: center;
    margin: 6px 0 28px; flex-wrap: wrap;
  }
  .theme-label {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--text-dim); margin-right: 2px;
  }
  .theme-swatch {
    width: 30px; height: 30px; border-radius: 50%; cursor: pointer;
    border: 2px solid rgba(128,128,128,0.35);
    box-shadow: 0 2px 6px rgba(0,0,0,0.35);
    transition: transform 0.15s ease, border-color 0.15s ease;
    padding: 0;
  }
  .theme-swatch:hover { transform: translateY(-2px) scale(1.06); }
  .theme-swatch:focus-visible { outline: 2px solid var(--accent-bright); outline-offset: 2px; }
  .theme-swatch.active { border-color: var(--accent-bright); box-shadow: 0 0 0 3px rgba(232,199,122,0.25), 0 2px 6px rgba(0,0,0,0.35); }

  /* ---- dice type tabs ---- */
  .dice-select { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-bottom: 30px; }

  .die-btn {
    font-family: var(--mono); font-weight: 600; font-size: 14px; color: var(--text-dim);
    background: linear-gradient(180deg, var(--panel-a), var(--panel-b));
    border: 1px solid var(--accent-dark);
    border-radius: 10px; padding: 10px 16px; cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease, color 0.15s ease,
                box-shadow 0.15s ease, background-color 0.4s ease;
  }
  .die-btn:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--text); }
  .die-btn:focus-visible { outline: 2px solid var(--accent-bright); outline-offset: 2px; }
  .die-btn.active {
    color: var(--ink); background: linear-gradient(180deg, var(--accent-bright), var(--accent-dark));
    border-color: var(--accent-bright); box-shadow: 0 0 18px rgba(232,199,122,0.3);
  }

  .tray-wrap { position: relative; width: min(100%, 460px); aspect-ratio: 1 / 1; }

  .tray-rim {
    position: absolute; inset: 0; border-radius: 50%; padding: 22px;
    background: conic-gradient(from 180deg,
      var(--accent-dark), var(--accent-bright), var(--accent-dark),
      var(--felt-dark), var(--accent-dark), var(--accent-bright), var(--accent-dark));
    box-shadow: 0 24px 50px -14px rgba(0,0,0,0.55), inset 0 0 0 2px rgba(255,255,255,0.08);
    cursor: pointer; transition: box-shadow 0.4s ease, background 0.5s ease;
  }
  .tray-rim:focus-visible { outline: 3px solid var(--accent-bright); outline-offset: 4px; }

  .tray-felt {
    position: relative; width: 100%; height: 100%; border-radius: 50%;
    background: radial-gradient(ellipse at 50% 40%, var(--felt-light) 0%, var(--felt) 55%, var(--felt-dark) 100%);
    box-shadow: inset 0 0 40px rgba(0,0,0,0.55), inset 0 0 90px rgba(0,0,0,0.45);
    display: flex; align-items: center; justify-content: center;
    transition: background 0.5s ease;
  }

  .tray-wrap.crit .tray-rim { box-shadow: 0 24px 50px -14px rgba(0,0,0,0.55), 0 0 60px 6px rgba(232,185,62,0.55); }
  .tray-wrap.fail .tray-rim { box-shadow: 0 24px 50px -14px rgba(0,0,0,0.55), 0 0 60px 6px rgba(192,88,74,0.55); }

  #dieHolder {
    width: 58%;
    filter: drop-shadow(0 14px 18px rgba(0,0,0,0.5)) blur(0px);
    transform: rotate(0deg) scale(1);
    will-change: transform, filter;
  }
  #dieHolder svg { width: 100%; height: 100%; display: block; }

  .status {
    margin: 22px 0 6px; min-height: 22px; text-align: center;
    font-family: var(--mono); font-size: 14px; color: var(--text-dim);
    transition: color 0.3s ease;
  }
  .status.crit { color: var(--crit); font-weight: 600; }
  .status.fail { color: var(--fail); font-weight: 600; }

  .ledger {
    width: min(100%, 560px); margin-top: 20px;
    background: linear-gradient(180deg, var(--panel-a), var(--panel-b));
    border: 1px solid var(--accent-dark); border-radius: 12px; padding: 18px 22px;
    transition: background 0.5s ease, border-color 0.5s ease;
  }
  .ledger h2 {
    font-family: var(--display); font-size: 15px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 10px; border-bottom: 1px solid var(--accent-dark); padding-bottom: 8px;
  }
  #log { list-style: none; margin: 0; padding: 0; max-height: 170px; overflow-y: auto; font-family: var(--mono); font-size: 13px; }
  #log li { display: flex; justify-content: space-between; padding: 6px 2px; border-bottom: 1px dashed rgba(128,128,128,0.2); color: var(--text-dim); }
  #log li:last-child { border-bottom: none; }
  #log li .val { color: var(--text); font-weight: 600; }
  #log li.crit .val { color: var(--crit); }
  #log li.fail .val { color: var(--fail); }
  #log .empty { text-align: center; padding: 14px 0; opacity: 0.6; font-style: italic; font-family: var(--body); }

  @media (prefers-reduced-motion: reduce) {
    .die-btn, .theme-swatch { transition: none; }
  }
</style>
</head>
<body>

<div class="stage">
  <header>
    <p class="eyebrow">The Gaming Table</p>
    <h1>Roll the <span>Bones</span></h1>
  </header>

  <div class="theme-select" id="themeSelect" role="group" aria-label="Choose a table theme">
    <span class="theme-label">Table</span>
  </div>

  <div class="dice-select" id="diceSelect" role="tablist" aria-label="Choose a die"></div>

  <div class="tray-wrap" id="trayWrap">
    <div class="tray-rim" id="tray" role="button" tabindex="0" aria-label="Roll the die">
      <div class="tray-felt">
        <div id="dieHolder"></div>
      </div>
    </div>
  </div>

  <p class="status" id="status" aria-live="polite">Click the tray, or press Enter / Space, to roll</p>

  <div class="ledger">
    <h2>Roll Log</h2>
    <ul id="log"><li class="empty">No rolls yet — give it a throw.</li></ul>
  </div>
</div>

<script>
/* =========================================================================
   ROLL THE BONES — 2D dice tray
   ========================================================================= */

const NS = 'http://www.w3.org/2000/svg';

function svgEl(tag, attrs) {
  const el = document.createElementNS(NS, tag);
  for (const k in attrs) el.setAttribute(k, attrs[k]);
  return el;
}

function polygonPoints(sides, radius, rotateDeg, cx = 60, cy = 64) {
  const pts = [];
  const rot = (rotateDeg * Math.PI) / 180;
  for (let i = 0; i < sides; i++) {
    const a = rot + (i * 2 * Math.PI) / sides;
    pts.push([cx + radius * Math.sin(a), cy - radius * Math.cos(a)]);
  }
  return pts.map(p => p.join(',')).join(' ');
}

function pipGroup(value, cx, cy, spread) {
  const layout = {
    1: [4], 2: [0, 8], 3: [0, 4, 8],
    4: [0, 2, 6, 8], 5: [0, 2, 4, 6, 8], 6: [0, 2, 3, 5, 6, 8]
  }[value] || [];
  const g = svgEl('g', {});
  layout.forEach(i => {
    const row = Math.floor(i / 3) - 1, col = (i % 3) - 1;
    const c = svgEl('circle', { cx: cx + col * spread, cy: cy + row * spread, r: 6.5, fill: '#1C1712' });
    g.appendChild(c);
  });
  return g;
}

// Dice keep their own gem colors regardless of table theme.
const SHAPES = {
  d4:  { sides: 3, radius: 56, rot: 0,   fill: '#A5453A', stroke: '#E8C77A', text: '#EFE3C8', numY: 92 },
  d6:  { sides: 4, radius: 58, rot: 45,  fill: '#EFE3C8', stroke: '#8C6B32', text: null,      rounded: true },
  d8:  { sides: 4, radius: 58, rot: 0,   fill: '#2F6B4F', stroke: '#E8C77A', text: '#EFE3C8', numY: 64 },
  d10: { sides: 5, radius: 58, rot: 180, fill: '#C9A356', stroke: '#5e461f', text: '#1C1712', numY: 68 },
  d12: { sides: 5, radius: 58, rot: 0,   fill: '#5B3E8C', stroke: '#E8C77A', text: '#EFE3C8', numY: 68 },
  d20: { sides: 6, radius: 58, rot: 0,   fill: '#E8B93E', stroke: '#8C6B32', text: '#1C1712', numY: 64 },
  d100:{ sides: 5, radius: 58, rot: 180, fill: '#B4894A', stroke: '#5e461f', text: '#1C1712', numY: 68 },
};

function renderFace(type, value, display) {
  const spec = SHAPES[type];
  const svg = svgEl('svg', { viewBox: '0 0 120 128' });

  if (spec.rounded) {
    svg.appendChild(svgEl('rect', {
      x: 6, y: 10, width: 108, height: 108, rx: 18,
      fill: spec.fill, stroke: spec.stroke, 'stroke-width': 4
    }));
    svg.appendChild(pipGroup(value, 60, 64, 20));
  } else {
    svg.appendChild(svgEl('polygon', {
      points: polygonPoints(spec.sides, spec.radius, spec.rot),
      fill: spec.fill, stroke: spec.stroke, 'stroke-width': 4, 'stroke-linejoin': 'round'
    }));
    const label = svgEl('text', {
      x: 60, y: spec.numY, 'text-anchor': 'middle', 'dominant-baseline': 'middle',
      fill: spec.text, 'font-family': "'Cinzel', serif", 'font-weight': '700',
      'font-size': display.length > 2 ? 26 : 34
    });
    label.textContent = display;
    svg.appendChild(label);
  }
  return svg;
}

const DICE_CONFIG = {
  d4:  { label: 'd4',  results: range(1, 4) },
  d6:  { label: 'd6',  results: range(1, 6) },
  d8:  { label: 'd8',  results: range(1, 8) },
  d10: { label: 'd10', results: range(1, 10) },
  d12: { label: 'd12', results: range(1, 12) },
  d20: { label: 'd20', results: range(1, 20), critical: true },
  d100:{ label: 'd%',  results: range(0, 9).map(n => n * 10), suffix: '%' },
};
const DICE_ORDER = ['d4', 'd6', 'd8', 'd10', 'd12', 'd20', 'd100'];
function range(a, b) { const out = []; for (let i = a; i <= b; i++) out.push(i); return out; }

const holder = document.getElementById('dieHolder');
const statusEl = document.getElementById('status');
const trayWrap = document.getElementById('trayWrap');
const tray = document.getElementById('tray');

let currentType = 'd20';
let rolling = false;

function paintDie(type, value) {
  const cfg = DICE_CONFIG[type];
  const display = String(value) + (cfg.suffix || '');
  holder.innerHTML = '';
  holder.appendChild(renderFace(type, value, display));
}

function randomFrom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

function mountDie(type) {
  const cfg = DICE_CONFIG[type];
  paintDie(type, randomFrom(cfg.results));
}
mountDie(currentType);

const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
function easeOutQuint(x) { return 1 - Math.pow(1 - x, 5); }

// ---------------------------------------------------------------------------
// Rolling — a single rAF-driven pass handles rotation, wobble, motion blur
// and face-flicker together so everything lands in the same instant instead
// of two separate timers finishing slightly out of sync.
// ---------------------------------------------------------------------------
function rollCurrentDie() {
  if (rolling) return;
  rolling = true;
  trayWrap.classList.remove('crit', 'fail');
  statusEl.classList.remove('crit', 'fail');
  statusEl.textContent = 'Rolling…';

  const cfg = DICE_CONFIG[currentType];
  const finalValue = randomFrom(cfg.results);

  if (reducedMotion) {
    paintDie(currentType, finalValue);
    finishRoll(finalValue, cfg);
    rolling = false;
    return;
  }

  const spins = 3 + Math.random();
  const duration = 1000;
  const start = performance.now();
  let nextFlicker = start;
  holder.style.transition = 'none';

  function frame(now) {
    const elapsed = now - start;
    const p = Math.min(elapsed / duration, 1);
    const eased = easeOutQuint(p);

    const angle = spins * 360 * eased;
    const wobble = Math.sin(p * Math.PI * 4) * 4 * (1 - p);
    const scale = 1 + Math.sin(p * Math.PI) * 0.06;
    holder.style.transform = `rotate(${angle + wobble}deg) scale(${scale})`;
    const blur = Math.max(0, 1 - p) * 2.4;
    holder.style.filter = `drop-shadow(0 14px 18px rgba(0,0,0,0.5)) blur(${blur}px)`;

    if (now >= nextFlicker && p < 1) {
      paintDie(currentType, randomFrom(cfg.results));
      nextFlicker = now + 40 + eased * 150; // flicker slows as the die "settles"
    }

    if (p < 1) {
      requestAnimationFrame(frame);
    } else {
      settle();
    }
  }

  function settle() {
    paintDie(currentType, finalValue);
    holder.style.transition = 'transform 0.34s cubic-bezier(.34,1.56,.64,1), filter 0.3s ease';
    holder.style.transform = 'rotate(360deg) scale(1)';
    holder.style.filter = 'drop-shadow(0 14px 18px rgba(0,0,0,0.5)) blur(0px)';
    setTimeout(() => {
      finishRoll(finalValue, cfg);
      rolling = false;
    }, 300);
  }

  requestAnimationFrame(frame);
}

function finishRoll(value, cfg) {
  const display = value + (cfg.suffix || '');
  const isCrit = cfg.critical && value === Math.max(...cfg.results);
  const isFail = cfg.critical && value === Math.min(...cfg.results);

  statusEl.textContent = isCrit ? `Critical hit! ${cfg.label} → ${display}`
                        : isFail ? `Fumble… ${cfg.label} → ${display}`
                        : `${cfg.label} → ${display}`;
  statusEl.classList.toggle('crit', isCrit);
  statusEl.classList.toggle('fail', isFail);
  trayWrap.classList.toggle('crit', isCrit);
  trayWrap.classList.toggle('fail', isFail);

  addLogEntry(cfg.label, display, isCrit, isFail);
}

function addLogEntry(label, display, isCrit, isFail) {
  const log = document.getElementById('log');
  const empty = log.querySelector('.empty');
  if (empty) empty.remove();

  const li = document.createElement('li');
  if (isCrit) li.classList.add('crit');
  if (isFail) li.classList.add('fail');
  const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  li.innerHTML = `<span>${label} · ${time}${isCrit ? ' · critical!' : ''}${isFail ? ' · fumble' : ''}</span><span class="val">${display}</span>`;
  log.prepend(li);
  while (log.children.length > 8) log.removeChild(log.lastChild);
}

// ---------------------------------------------------------------------------
// Dice type tabs
// ---------------------------------------------------------------------------
const selectEl = document.getElementById('diceSelect');
DICE_ORDER.forEach(type => {
  const btn = document.createElement('button');
  btn.className = 'die-btn' + (type === currentType ? ' active' : '');
  btn.textContent = DICE_CONFIG[type].label;
  btn.setAttribute('role', 'tab');
  btn.setAttribute('aria-selected', type === currentType ? 'true' : 'false');
  btn.addEventListener('click', () => {
    if (rolling) return;
    currentType = type;
    mountDie(type);
    statusEl.textContent = 'Click the tray, or press Enter / Space, to roll';
    statusEl.classList.remove('crit', 'fail');
    trayWrap.classList.remove('crit', 'fail');
    [...selectEl.children].forEach(b => {
      b.classList.toggle('active', b === btn);
      b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
    });
  });
  selectEl.appendChild(btn);
});

tray.addEventListener('click', rollCurrentDie);
tray.addEventListener('keydown', e => {
  if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); rollCurrentDie(); }
});

// ---------------------------------------------------------------------------
// Table themes
// ---------------------------------------------------------------------------
const THEMES = [
  { id: 'emerald',   name: 'Emerald Table',    swatch: ['#1B3A2F', '#E8C77A'] },
  { id: 'dragon',    name: 'Dragonfire Hoard', swatch: ['#3B1414', '#FBD98A'] },
  { id: 'moon',      name: 'Ninth Moon',       swatch: ['#16213A', '#E4ECFB'] },
  { id: 'parchment', name: 'Sunlit Parchment', swatch: ['#D3A272', '#8C5A1E'] },
  { id: 'frost',     name: 'Frostspire',       swatch: ['#A8C8E0', '#5D7E97'] },
];

const themeSelectEl = document.getElementById('themeSelect');
const savedTheme = localStorage.getItem('rtb-theme');
const initialTheme = THEMES.some(t => t.id === savedTheme) ? savedTheme : 'emerald';
document.documentElement.setAttribute('data-theme', initialTheme);

THEMES.forEach(theme => {
  const btn = document.createElement('button');
  btn.className = 'theme-swatch' + (theme.id === initialTheme ? ' active' : '');
  btn.style.background = `linear-gradient(135deg, ${theme.swatch[0]}, ${theme.swatch[1]})`;
  btn.title = theme.name;
  btn.setAttribute('aria-label', theme.name);
  btn.setAttribute('aria-pressed', theme.id === initialTheme ? 'true' : 'false');
  btn.addEventListener('click', () => {
    document.documentElement.setAttribute('data-theme', theme.id);
    localStorage.setItem('rtb-theme', theme.id);
    [...themeSelectEl.querySelectorAll('.theme-swatch')].forEach(b => {
      const active = b === btn;
      b.classList.toggle('active', active);
      b.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  });
  themeSelectEl.appendChild(btn);
});
</script>
</body>
</html>
